{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/micss-lab/ML-QuadratPP/replication/manifests/run-manifest.schema.json",
  "title": "ML2++ dissertation run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "generator_commit",
    "execution_command",
    "environment",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "generator_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_command": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "required": ["platform", "python"],
      "properties": {
        "platform": {"type": "string"},
        "python": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "additionalProperties": true
}
