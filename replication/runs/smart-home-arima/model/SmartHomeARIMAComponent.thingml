// PROVENANCE: transcribed from final Chapter 5 technical-validation Listing 1.3 (2026-08-14).
// STATUS: declaration/model-specification evidence only; this file is not asserted
// to be the byte-exact executed source.

thing SmartHomeARIMAComponent {
  property use_kW : Double
  property prediction1 : Double
  property prediction2 : Double
  property prediction3 : Double

  data_analytics arimaAnalytics @dalib `statsmodels` {
    data {
      dataset "data/use_case_2_smart_home_energy.csv"
      features use_kW
      input_features use_kW
      output_features use_kW
      timestamps ON
    }

    preprocessing {
      fill_missing OFF
      remove_outliers OFF
    }

    time_series {
      sequential TRUE
      steps 3
      multivariate OFF
      stationary_check ON
      seasonality_detection ON
      supervised_learning OFF
      create_lagged_features OFF
    }

    model {
      autoML OFF
      algorithm ARIMA arima_energy(
        p 1,
        differencing 1,
        q 1,
        trend "n",
        forecasting_plots FORECAST_VS_ACTUAL
      )
      training_results "data/arima_energy_training.txt"
    }

    evaluation {
      prediction_results prediction1, prediction2, prediction3
      metrics RMSE
    }

    visualization {
      plots LINE_PLOT, AUTOCORRELATION_PLOT
    }
  }
}
