// PROVENANCE: transcribed from final Chapter 5 technical-validation Listing 1.4 (2026-08-14).
// STATUS: declaration/model-specification evidence only; this file is not asserted
// to be the byte-exact executed source.

thing SmartHomeHoltWintersComponent {
  property use_kW : Double
  property prediction1 : Double
  property prediction2 : Double
  property prediction3 : Double

  data_analytics hwAnalytics @dalib `statsmodels` {
    data {
      dataset "data/use_case_2_smart_home_energy.csv"
      features use_kW
      input_features use_kW
      output_features use_kW
      timestamps ON
    }

    preprocessing {
      fill_missing OFF
      remove_outliers OFF
    }

    time_series {
      sequential TRUE
      steps 3
      multivariate OFF
      stationary_check ON
      seasonality_detection ON
      supervised_learning OFF
      create_lagged_features OFF
    }

    model {
      autoML OFF
      algorithm HWES holt_winters_energy(
        trend "add",
        damped true,
        seasonal "add",
        seasonal_periods 60,
        initialization_method "heuristic",
        use_boxcox false,
        remove_bias false,
        optimized true,
        forecasting_plots FORECAST_VS_ACTUAL
      )
      training_results "data/holt_winters_energy_training.txt"
    }

    evaluation {
      prediction_results prediction1, prediction2, prediction3
      metrics RMSE
    }

    visualization {
      plots LINE_PLOT, AUTOCORRELATION_PLOT
    }
  }
}
