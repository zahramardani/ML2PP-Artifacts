// PROVENANCE: transcribed from final Chapter 5 technical-validation Listing 1.1 (2026-08-14).
// STATUS: declaration/model-specification evidence only; this file is not asserted
// to be the byte-exact executed source.

thing RiverForecastLSTMComponent {
  property fratel_discharge : Double
  property castelo_bode_discharge : Double
  property almourol_discharge : Double
  property prediction1 : Double
  property prediction2 : Double
  property prediction3 : Double

  data_analytics lstmAnalytics @dalib `keras-tensorflow` {
    data {
      dataset "data/use_case_1_river_flow_observed.csv"
      features fratel_discharge, castelo_bode_discharge, almourol_discharge
      input_features fratel_discharge, castelo_bode_discharge, almourol_discharge
      output_features almourol_discharge
      timestamps ON
      common_period_threshold 10
    }

    preprocessing {
      fill_missing FF
      resample DAILY
      remove_outliers OFF
    }

    time_series {
      sequential TRUE
      steps 3
      lag 20
      multivariate ON
      stationary_check ON
      seasonality_detection ON
      supervised_learning ON
      create_lagged_features OFF
      sliding_window ON
    }

    model {
      autoML OFF
      algorithm LSTM lstm_almourol(
        units 64,
        hidden_layer_sizes (64),
        return_sequences false,
        input_activation tanh,
        hidden_activation tanh,
        output_activation linear,
        dropout 0.2,
        optimizer adam,
        rate 0.001,
        batch_size 32,
        epochs 100,
        metrics 'MAE',
        early_stopping 'enable',
        overfitting_Plots TRAINING_LOSS,
        forecasting_plots FORECAST_VS_ACTUAL
      )
      training_results "data/lstm_almourol_training.txt"
      hyperparameter_tuning OFF
    }

    evaluation {
      prediction_results prediction1, prediction2, prediction3
      metrics MSE
    }

    visualization {
      plots LINE_PLOT, HEAT_MAP
    }
  }
}
