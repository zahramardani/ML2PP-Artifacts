// PROVENANCE: transcribed from final Chapter 5 technical-validation Listing 1.5 (2026-08-14).
// STATUS: declaration/model-specification evidence only; this file is not asserted
// to be the byte-exact executed source.

thing SolarXGBoostComponent {
  property DC_POWER : Double
  property prediction1 : Double
  property prediction2 : Double

  data_analytics xgbAnalytics @dalib `xgboost` {
    data {
      dataset "data/use_case_3_solar_power_hourly.csv"
      features DC_POWER
      input_features DC_POWER
      output_features DC_POWER
      timestamps ON
    }

    preprocessing {
      fill_missing FF
      remove_outliers OFF
    }

    time_series {
      sequential TRUE
      steps 2
      lag 20
      multivariate OFF
      stationary_check ON
      seasonality_detection ON
      supervised_learning ON
      create_lagged_features ON
    }

    model {
      autoML OFF
      algorithm XGBoost xgb_solar(
        max_depth 2,
        learning_rate 0.05,
        n_estimators 200,
        objective "reg:squarederror",
        booster "gbtree",
        min_child_weight 3.0,
        subsample 0.8,
        colsample_bytree 1.0,
        reg_lambda 5.0,
        random_state 42,
        forecasting_plots FORECAST_VS_ACTUAL
      )
      training_results "data/xgboost_solar_training.txt"
      hyperparameter_tuning OFF
    }

    evaluation {
      prediction_results prediction1, prediction2
      metrics RMSE
    }

    visualization {
      plots LINE_PLOT, LAG_PLOT, AUTOCORRELATION_PLOT
    }
  }
}
